Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /app.php

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.)
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Nunca servir includes, pages, storage, docs, herramientas ni .env
RewriteRule ^(includes|pages|storage|docs|tools|audit-shots)(/|$) - [F]
RewriteRule ^\.env - [F]
# Deploy por Git: la raíz del repo es el sitio; cerramos .git y archivos de desarrollo.
RewriteRule (^|/)\.git(/|$) - [F]
RewriteRule ^(router|verify)\.(php|sh)$ - [F]
RewriteRule \.(md|sh|lock|log|example|json)$ - [F,NC]
# app.php, index.php, sitemap.php y robots.php solo por reescritura interna
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(app|index|sitemap|robots)\.php$ - [F]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# 301 permanentes. Mantener igual que redirects() en includes/routes.php
# (verify.sh compara ambas listas) y docs/audit/redirects.tsv.
RewriteRule ^contacto/?$ /contanos-tu-proyecto/ [R=301,L]
RewriteRule ^postulate/?$ /para-arquitectos/ [R=301,L]
RewriteRule ^nosotros/?$ /como-funciona/ [R=301,L]
RewriteRule ^planos/?$ /servicios/planos-documentacion-municipal/ [R=301,L]
RewriteRule ^carpeta/?$ /servicios/planos-documentacion-municipal/ [R=301,L]
RewriteRule ^diseno/?$ /servicios/anteproyecto-arquitectonico/ [R=301,L]
RewriteRule ^estructural/?$ /servicios/calculo-estructural/ [R=301,L]
RewriteRule ^como-trabajamos/?$ /como-funciona/ [R=301,L]
RewriteRule ^cotizar/?$ /contanos-tu-proyecto/ [R=301,L]

# Barra final en todas las páginas: /obras -> /obras/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z0-9/-]*[a-z0-9-])$ /$1/ [R=301,L]

# Todo lo demás que no sea un archivo lo resuelve app.php (includes/routes.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ app.php [L,QSA]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
