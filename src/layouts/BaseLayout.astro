---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Set true when the page opens on a dark hero so the header starts in light-on-dark mode. */
  transparentHeader?: boolean;
}

const {
  title = 'arq.com.py — Arquitectura del Paraguay',
  description = 'La selección de la mejor arquitectura del Paraguay y los estudios que la crean. Explorá obras, encontrá tu arquitecto.',
  transparentHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#141210" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="arq.com.py" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PY" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: Fraunces (display) + Archivo (body). Preconnect for speed. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <SiteHeader transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
