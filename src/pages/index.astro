---
import BaseLayout from '../layouts/BaseLayout.astro';
// NOTE: Placeholder home page — Phase 2 (Opus) replaces this with the full-height
// hero + scroll experience per PLAN.md §2. This exists so Phase 1 builds and the
// design system can be smoke-tested.
---

<BaseLayout transparentHeader>
  <section class="hero band-dark">
    <div class="container container-wide hero__inner">
      <p class="eyebrow">Arquitectura del Paraguay — Selección 2026</p>
      <h1 class="hero__title">La arquitectura que el mundo mira.</h1>
      <p class="hero__sub">
        La selección de las mejores obras del Paraguay y los estudios que las crean.
      </p>
      <div class="hero__actions">
        <a href="/obras" class="btn">Explorar obras</a>
        <a href="/arquitectos" class="btn btn--ghost">Encontrá tu arquitecto</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <p class="folio">N° 001</p>
    <hr class="rule" style="margin-block: var(--space-md) var(--space-xl);" />
    <p style="max-width: var(--measure); font-size: var(--step-1);">
      Fase&nbsp;1 completa: sistema de diseño, tipografía, navegación y pie de página.
      La portada definitiva llega en la Fase&nbsp;2.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: var(--space-4xl) var(--space-3xl);
  }
  .hero__inner { width: 100%; }
  .hero__title { font-size: var(--step-5); max-width: 16ch; margin-block: var(--space-lg) var(--space-lg); }
  .hero__sub { color: var(--fg-muted); font-size: var(--step-1); max-width: 42ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-top: var(--space-xl); }
</style>
